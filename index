    <script>
        window.addEventListener('load', () => {
            const overlay = document.getElementById('intro-overlay');
            const ckScreen = document.getElementById('climate-kind-screen');
            generateQuotes();
            
            setTimeout(() => {
                overlay.style.transform = 'translateY(-100%)';
                setTimeout(() => { 
                    ckScreen.style.opacity = '1';
                    overlay.style.display = 'none';
                }, 1000);
            }, 6000); 
        });

        function revealSite() {
            const ckScreen = document.getElementById('climate-kind-screen');
            const main = document.getElementById('main-content');
            
            ckScreen.style.transform = 'translateY(-100%)';
            document.body.style.overflow = 'auto'; 
            
            setTimeout(() => { 
                main.style.opacity = '1'; 
                ckScreen.style.display = 'none';
            }, 1000);
        }

        function exploreMore() {
            const matterText = document.getElementById('you-matter');
            matterText.classList.add('type-blink');
            document.getElementById('front-content').style.opacity = '0';
            setTimeout(() => {
                const back = document.getElementById('back-content');
                back.style.opacity = '1'; back.style.zIndex = '10';
            }, 1600); 
        }

        function toggleOverlay(id, show) {
            const page = document.getElementById(id);
            page.classList.toggle('open', show);
            document.body.style.overflow = show ? 'hidden' : 'auto';
        }

        function generateQuotes() {
            const board = document.getElementById('pinterest-board');
            
            // Custom palette array matching your requirement: light beige, dark beige shades, and warm white shades
            const beigePalette = [
                { bg: '#fdfbfa', text: '#5c5247' }, // Warm Pearl White
                { bg: '#f4ede2', text: '#6b5e50' }, // Light Cream Beige
                { bg: '#ebdcc1', text: '#4d4235' }, // Soft Medium Beige
                { bg: '#dfcca9', text: '#42372c' }, // Radiant Pale Gold Beige
                { bg: '#c9b79c', text: '#ffffff' }, // Matte Dark Beige (White text for contrast)
                { bg: '#bda68a', text: '#ffffff' }, // Deep Ochre Dark Beige (White text)
                { bg: '#a38c72', text: '#fbf9f6' }, // Premium Dark Shadow Beige
                { bg: '#ffffff', text: '#6e6152' }  // Stark Crisp White
            ];

            // Rich extended list of Pinterest quotes covering Self-Love, Freedom, Friendship, and Kindness
            const quotes = [
                "To love oneself is the beginning of a lifelong romance.",
                "You inherit the freedom to recreate who you are at any moment.",
                "In a world where you can be anything, be kind.",
                "A true friend is someone who dances with you in the sunlight and holds the umbrella in the rain.",
                "You owe yourself the love you so freely give to other people.",
                "Freedom is not the absence of boundaries, but the courage to draw your own.",
                "Be gentle with your soul; it is doing the best it can.",
                "Kindness is the ultimate currency, and it costs nothing to spend.",
                "Waters roll, winds howl, but true friendship remains unbothered.",
                "You are allowed to be both a masterpiece and a work in progress.",
                "The only real cages are the expectations we refuse to untie.",
                "Unexpected kindness is the most beautiful, elegant gesture in life.",
                "Choose friends who value your quiet just as much as your noise.",
                "To choose your own joy is the ultimate declaration of independence.",
                "You do not have to conquer the world to be worthy of rest.",
                "Plant your own garden instead of waiting for someone to bring you flowers.",
                "Freedom feels like a quiet room inside your mind where no external opinion lives.",
                "A soft heart is a sign of immense strength, not weakness.",
                "We grow beautiful by the truth we speak and the grace we offer.",
                "Surround yourself with people who make you feel like a breath of fresh air.",
                "Your heart is an infinite ocean; make sure you swim in it too.",
                "Unbound, unbothered, and entirely your own.",
                "Kindness reflects back like oil on smooth water.",
                "Friendship is finding the rare souls who speak the exact same silent language.",
                "Allow yourself the freedom to change your mind and heal your heart.",
                "You are rare. Act accordingly.",
                "No one can make you feel small without your own internal vote.",
                "Be the reason someone believes in the goodness of people today.",
                "Conscious freedom begins the second you realize you hold the key.",
                "Keep close to those who feel like soft sunlight on a crisp morning."
            ];

            // Generating 36 cards to create a beautiful, dense mosaic grid layout
            for(let i = 0; i < 36; i++) {
                const card = document.createElement('div');
                card.className = 'quote-card';
                card.innerText = quotes[i % quotes.length];
                card.style.height = (140 + Math.random() * 90) + "px";
                
                // Fetch random color schema from the customized beige profile array
                const schema = beigePalette[Math.floor(Math.random() * beigePalette.length)];
                card.style.backgroundColor = schema.bg;
                card.style.color = schema.text;
                
                board.appendChild(card);
            }
        }
    </script>
</body>
